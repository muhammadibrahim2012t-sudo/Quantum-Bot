# Add the real values in Vercel Project Settings > Environment Variables.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: defaults to gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional: restrict CORS if your frontend is hosted on another domain
ALLOWED_ORIGIN=https://your-quantum-bot-domain.vercel.app
# Existing chat provider key (set this if using Gemini chat)
GEMINI_API_KEY=your_gemini_api_key_here
